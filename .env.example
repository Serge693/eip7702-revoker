# === EIP-7702 Revoker v2 Configuration ===
#
# Copy this file to .env and fill in your keys.
# The tool can also be used with --interactive flag (no .env file needed).

# Source account (the wallet whose delegation you want to revoke/set).
# This account signs the authorization — needs ZERO ETH.
SOURCE_PRIVATE_KEY=0x...

# Legacy name (kept for compatibility). Only used if SOURCE_PRIVATE_KEY is not set.
# VICTIM_PRIVATE_KEY=0x...

# Sponsor account (pays gas fees). Should hold a small amount of ETH on each network.
# Use a SEPARATE account for security!
SPONSOR_PRIVATE_KEY=0x...

# Address to delegate to (only needed for `delegate` command).
# For revoke, this is ignored (zero address is used automatically).
# DELEGATE_TO=0x...

# Minimum sponsor balance in ETH. Tool will refuse to proceed if sponsor
# has less than this on any target network.
SPONSOR_MIN_BALANCE=0.003

# Delay (ms) before verifying delegation status after tx confirmation.
# Increase if your RPC node caches bytecode aggressively.
EIP7702_VERIFY_DELAY=3000

# Set to 1 to suppress non-JSON output (config banner, progress, etc.).
# Automatically enabled when --json flag is used.
# SILENT=1
