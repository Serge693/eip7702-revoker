# === EIP-7702 Revoker Configuration ===

# Private key of the account you want to revoke/delegate (victim)
VICTIM_PRIVATE_KEY=0x...

# Private key of the account that will pay for gas (recommended to be separate)
SPONSOR_PRIVATE_KEY=0x...

# (Optional) Address to delegate to. Leave empty or 0x0 for revoke
DELEGATE_TO=0x...
