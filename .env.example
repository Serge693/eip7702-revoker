# === EIP-7702 Revoker Configuration ===

# Основной аккаунт (victim) — от которого идёт revoke/delegate
# Это аккаунт, делегацию которого вы хотите отозвать
SOURCE_PRIVATE_KEY=0x...

# Старое имя (оставлено для совместимости)
# VICTIM_PRIVATE_KEY=0x...

# Спонсор газа — аккаунт, который будет платить за транзакцию
# Рекомендуется использовать ОТДЕЛЬНЫЙ аккаунт!
SPONSOR_PRIVATE_KEY=0x...

# Адрес, на который делегировать (для revoke оставьте 0x000... или пустым)
DELEGATE_TO=0x...

# Минимальный баланс спонсора (в ETH)
SPONSOR_MIN_BALANCE=0.003
