# === EIP-7702 Revoker Configuration ===

# Private key of the account you want to revoke/delegate (recommended name)
SOURCE_PRIVATE_KEY=0x...

# Old name (still supported for backward compatibility)
# VICTIM_PRIVATE_KEY=0x...

# Account that will pay for gas (recommended to be separate)
SPONSOR_PRIVATE_KEY=0x...

# Address to delegate to (leave empty or 0x0 for revoke)
DELEGATE_TO=0x...

# Minimum sponsor balance in ETH (optional)
SPONSOR_MIN_BALANCE=0.003
