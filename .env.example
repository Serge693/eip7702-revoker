# =============================================
# EIP-7702 Revoker — Configuration
# =============================================

# Main account (the one you want to revoke or delegate)
VICTIM_PRIVATE_KEY=0x

# Sponsor account (pays for gas). It is strongly recommended to use a separate account.
SPONSOR_PRIVATE_KEY=0x

# Target address for delegation (only used by delegate.mjs)
DELEGATE_TO=0x

# Example:
# DELEGATE_TO=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
